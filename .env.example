DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional comma-separated allowlist. Leave empty to allow any Google account.
FITAI_ALLOWED_EMAILS=""

# Public app URL used by sitemap, robots.txt and metadata
NEXT_PUBLIC_SITE_URL="https://your-production-domain.vercel.app"

# OpenAI program generation
OPENAI_API_KEY="sk-your-openai-api-key"

# Stripe subscriptions
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_PRICE_ID="price_your-monthly-or-yearly-plan"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Google Play Billing for Android subscriptions.
GOOGLE_PLAY_PACKAGE_NAME="com.fitai.proapp"
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID="traknio_premium"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Or split service account credentials:
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional key for encrypting integration refresh/access tokens. Falls back to AUTH_SECRET if omitted.
INTEGRATION_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Spotify OAuth
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="https://your-production-domain.vercel.app/api/integrations/spotify/callback"

# Wear OS native app pairing token. Keep empty only while migrating old watch builds.
FITAI_WATCH_TOKEN="generate-a-long-random-token"
# Optional per-account device token generated in Settings > Wear OS pairing.
FITAI_WATCH_DEVICE_TOKEN=""

# Android Health sync uses per-account device tokens issued from the signed-in mobile app.
