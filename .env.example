DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional comma-separated allowlist. Leave empty to allow any Google account.
FITAI_ALLOWED_EMAILS=""

# Public app URL used by sitemap, robots.txt and metadata
NEXT_PUBLIC_SITE_URL="https://your-production-domain.vercel.app"

# Wear OS native app pairing token. Keep empty only while migrating old watch builds.
FITAI_WATCH_TOKEN="generate-a-long-random-token"
