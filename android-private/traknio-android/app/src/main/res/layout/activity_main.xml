<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/traknio_system_bar">

    <WebView
        android:id="@+id/webViewTraknio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_system_bar" />

    <ProgressBar
        android:id="@+id/webLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/launchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_system_bar"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/launchArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/launch_art_description"
            android:scaleType="centerCrop"
            android:src="@drawable/traknio_launch_art" />

        <View
            android:id="@+id/launchProgressMask"
            android:layout_width="176dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="25dp"
            android:background="@color/traknio_system_bar" />

        <ProgressBar
            android:id="@+id/launchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="168dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="31dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="6"
            android:progressDrawable="@drawable/launch_progress" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/webErrorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_system_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/webErrorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/web_error_title"
            android:textColor="#F7F9FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/webErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/web_error_message"
            android:textColor="#8A94A6"
            android:textSize="15sp" />

        <Button
            android:id="@+id/webRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/web_error_retry" />

    </LinearLayout>

</FrameLayout>
