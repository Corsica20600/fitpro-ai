<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/traknio_system_bar">

    <WebView
        android:id="@+id/webViewTraknio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_system_bar" />

    <ProgressBar
        android:id="@+id/webLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/launchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_splash_background"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/launchArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/launch_art_description"
            android:scaleType="fitCenter"
            android:src="@drawable/traknio_launch_art" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.16"
                android:text="@string/launch_loading"
                android:textColor="#E8EEFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="224dp"
                android:layout_height="14dp"
                android:gravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launch_progress_glow" />

                <ProgressBar
                    android:id="@+id/launchProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="208dp"
                    android:layout_height="6dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/launch_progress" />
            </FrameLayout>
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/webErrorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/traknio_system_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/webErrorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/web_error_title"
            android:textColor="#F7F9FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/webErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/web_error_message"
            android:textColor="#8A94A6"
            android:textSize="15sp" />

        <Button
            android:id="@+id/webRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/web_error_retry" />

    </LinearLayout>

</FrameLayout>
